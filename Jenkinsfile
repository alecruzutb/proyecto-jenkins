pipeline {
    agent any
 
    stages {
 
        stage('Checkout') {
            steps {
                echo 'Clonando repositorio...'
            }
        }
 
        stage('Build') {
            steps {
                echo 'Construyendo proyecto...'
            }
        }
 
        stage('Test') {
            steps {
                echo 'Ejecutando pruebas...'
            }
        }
 
        stage('Deploy Simulation') {
            steps {
                echo 'Simulando despliegue...'
            }
        }
 
    }
}